    {"id": "priv", "style": "private-subnet", "label": "Private subnet", "contains": ["ecs", "rds"]}
  ],
  "edges": [
    {"from": "users", "to": "cf", "step": 1},
    {"from": "users", "to": "r53", "kind": "async", "label": "DNS"},
    {"from": "cf", "to": "alb", "step": 2},
    {"from": "cf", "to": "s3", "kind": "async"},
    {"from": "alb", "to": "ecs", "step": 3},
    {"from": "ecs", "to": "rds", "step": 4},
    {"from": "ecs", "to": "sm", "kind": "monitor"}
